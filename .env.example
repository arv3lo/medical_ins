# Copier en .env puis adapter. Utilisé par docker-compose et par l'API en local.

# Domaine public servi par Caddy (TLS automatique). "localhost" pour un test local.
DOMAIN=localhost

# PostgreSQL
POSTGRES_USER=medins
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medins
DATABASE_URL=postgres://medins:change-me@localhost:5432/medins

# API
API_PORT=3000
SESSION_TTL_HOURS=12
# Mettre à true derrière HTTPS (cookie Secure)
COOKIE_SECURE=false

# Compte super admin créé par `pnpm db:seed`
SEED_ADMIN_EMAIL=admin@example.mg
SEED_ADMIN_PASSWORD=change-me-admin

# Base dédiée aux tests d'intégration de l'API (créée par docker-compose.dev.yml)
TEST_DATABASE_URL=postgres://medins:change-me@localhost:5432/medins_test
